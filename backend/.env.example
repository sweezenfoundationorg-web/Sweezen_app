# ========================================================
# SWEEZEN FOUNDATION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ========================================================

PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:5432/sweezen_db
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sweezen_db
PGPORT=5432

# Gmail SMTP for OTP
SMTP_EMAIL=your-gmail-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Push Notifications (FCM)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
