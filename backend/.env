# ========================================================
# SWEEZEN FOUNDATION BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server Options
PORT=5000
NODE_ENV=development
JWT_SECRET=sweezen_jwt_secret_key_2026_super_secure

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweezen_db
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sweezen_db
PGPORT=5432

# Gmail SMTP Credentials for OTP Dispatch
# Step 1: Turn on 2-Step Verification on your Gmail Account
# Step 2: Generate an "App Password" at https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password

# Razorpay Payment Gateway API Keys
RAZORPAY_KEY_ID=rzp_test_sweezen_key_123
RAZORPAY_KEY_SECRET=sweezen_secret_key_456

# Firebase Cloud Messaging (FCM Push Notifications)
FIREBASE_PROJECT_ID=sweezen-foundation-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sweezen-foundation-fcm.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
